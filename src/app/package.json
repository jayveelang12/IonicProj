{
  "name": "fitflow",
  "version": "1.0.0",
  "private": true,
  "description": "FitFlow workout planner and interval timer",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --project fitflow",
    "build": "ng build --project fitflow",
    "build:android": "ng build --project fitflow && npx cap sync android",
    "android:add": "npx cap add android",
    "android:setup": "node scripts/setup-android.mjs",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/local-notifications": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@ionic/angular": "^8.5.0",
    "@types/leaflet": "^1.9.22",
    "ionicons": "^7.4.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/cli": "^7.4.3",
    "@ionic/angular-toolkit": "^12.0.0",
    "typescript": "~5.7.3"
  }
}
